
<!DOCTYPE html>
<html>
<head>
    <title>ABC College</title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
            background-color: #f2f2f2;
        }

        /* Navigation Bar */
        nav {
            background-color: darkblue;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-size: 18px;
        }

        /* Banner */
        header {
            background-color: lightblue;
            text-align: center;
            padding: 40px;
        }

        header h1 {
            color: darkblue;
        }

        /* Information Cards */
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background-color: white;
            width: 250px;
            margin: 15px;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 0 5px gray;
        }

        .card h2 {
            color: darkblue;
        }

        /* Footer */
        footer {
            background-color: darkblue;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#departments">Departments</a>
        <a href="#admissions">Admissions</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- Banner -->
    <header id="home">
        <h1>ABC College</h1>
        <h3>Welcome to Our College</h3>
        <p>Education is the key to success</p>
    </header>

    <!-- About Section -->
    <div class="container" id="about">
        <div class="card">
            <h2>About Us</h2>
            <p>Our college provides quality education and a bright future for students.</p>
        </div>

        <div class="card" id="departments">
            <h2>Departments</h2>
            <p>Computer Science, Mathematics, Physics and Commerce.</p>
        </div>

        <div class="card">
            <h2>Courses</h2>
            <p>BCA, B.Sc, B.Com and BBA courses are available.</p>
        </div>

        <div class="card">
            <h2>Faculty</h2>
            <p>Experienced and qualified faculty members guide students.</p>
        </div>

        <div class="card">
            <h2>Campus Facilities</h2>
            <p>Library, Computer Lab, Sports, Hostel and Wi-Fi facilities.</p>
        </div>

        <div class="card">
            <h2>Events</h2>
            <p>Annual Day, Sports Day, Cultural Events and Workshops.</p>
        </div>

        <div class="card" id="admissions">
            <h2>Admissions</h2>
            <p>Students can apply for admission through our college office.</p>
        </div>

        <div class="card" id="contact">
            <h2>Contact Us</h2>
            <p>Email: abccollege@gmail.com</p>
            <p>Phone: 9876543210</p>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p>© 2026 ABC College. All Rights Reserved.</p>
    </footer>

</body>
</html>
