
<!DOCTYPE html>
<html>
<head>
    <title>Online Learning Platform</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background-color: #f4f4f4;
        }

        /* Navigation Bar */
        nav {
            background-color: #222;
            padding: 18px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        nav a:hover {
            color: yellow;
        }

        /* Banner */
        header {
            background-color: #3498db;
            color: white;
            text-align: center;
            padding: 40px;
        }

        /* Course Categories */
        .categories {
            text-align: center;
            padding: 20px;
        }

        .categories span {
            background-color: #3498db;
            color: white;
            padding: 10px;
            margin: 5px;
            display: inline-block;
            border-radius: 5px;
        }

        /* Course Cards */
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background-color: white;
            width: 270px;
            margin: 15px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 0 5px gray;
            text-align: center;
        }

        .thumbnail {
            background-color: #d6eaf8;
            padding: 35px 10px;
            font-size: 25px;
            border-radius: 5px;
        }

        .card h2 {
            color: #3498db;
        }

        /* Progress Bar */
        .progress {
            background-color: #ddd;
            height: 15px;
            border-radius: 10px;
            margin: 10px 0;
        }

        .progress-bar {
            background-color: green;
            height: 15px;
            border-radius: 10px;
            width: 60%;
        }

        /* Button */
        button {
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: darkblue;
        }

        /* Instructor */
        .instructor {
            color: gray;
        }

        /* Footer */
        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 15px;
        }

        /* Responsive Design */
        @media(max-width: 600px) {
            .card {
                width: 90%;
            }

            nav a {
                display: inline-block;
                margin: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#categories">Categories</a>
        <a href="#courses">Courses</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- Banner -->
    <header id="home">
        <h1>Online Learning Platform</h1>
        <h3>Learn New Skills Anytime, Anywhere</h3>
        <p>Improve your knowledge with our online courses.</p>
    </header>

    <!-- Categories -->
    <div class="categories" id="categories">
        <h2>Course Categories</h2>
        <span>Programming</span>
        <span>Web Development</span>
        <span>Data Science</span>
        <span>Design</span>
    </div>

    <!-- Courses -->
    <div class="container" id="courses">

        <!-- Course 1 -->
        <div class="card">
            <div class="thumbnail">▶ Python Course</div>

            <h2>Python Programming</h2>

            <p class="instructor">Instructor: Ravi Kumar</p>

            <p>Learn Python from basic to advanced concepts.</p>

            <h3>Learning Objectives</h3>
            <p>Variables, Loops, Functions and Lists.</p>

            <p>Course Progress: 60%</p>

            <div class="progress">
                <div class="progress-bar"></div>
            </div>

            <button onclick="alert('Successfully Enrolled!')">
                Enroll Now
            </button>
        </div>

        <!-- Course 2 -->
        <div class="card">
            <div class="thumbnail">▶ HTML & CSS</div>

            <h2>Web Development</h2>

            <p class="instructor">Instructor: Priya Sharma</p>

            <p>Learn how to create attractive websites.</p>

            <h3>Learning Objectives</h3>
            <p>HTML, CSS, Forms and Web Design.</p>

            <p>Course Progress: 40%</p>

            <div class="progress">
                <div class="progress-bar" style="width:40%"></div>
            </div>

            <button onclick="alert('Successfully Enrolled!')">
                Enroll Now
            </button>
        </div>

        <!-- Course 3 -->
        <div class="card">
            <div class="thumbnail">▶ Data Science</div>

            <h2>Data Science</h2>

            <p class="instructor">Instructor: Arun Kumar</p>

            <p>Understand data analysis and visualization.</p>

            <h3>Learning Objectives</h3>
            <p>Python, Data Analysis and Charts.</p>

            <p>Course Progress: 75%</p>

            <div class="progress">
                <div class="progress-bar" style="width:75%"></div>
            </div>

            <button onclick="alert('Successfully Enrolled!')">
                Enroll Now
            </button>
        </div>

    </div>

    <!-- Contact -->
    <footer id="contact">
        <h3>Contact Us</h3>
        <p>Email: learnonline@gmail.com</p>
        <p>Phone: 9876543210</p>
        <p>© 2026 Online Learning Platform</p>
    </footer>

</body>
</html>
